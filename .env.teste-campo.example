# =====================================================================
#  TESTE DE CAMPO — robô próprio Elektro
#  JEITO MAIS FÁCIL: rode  npm run teste-campo -- configurar
#  (ele pergunta login, senha (oculta), estado e UC e cria o arquivo).
#
#  Ou à mão: copie este arquivo para  .env.teste-campo  e preencha.
#  O .env.teste-campo NUNCA vai para o GitHub (.gitignore). Não mande a
#  senha por chat nem por e-mail: ela só existe neste arquivo, no seu Mac.
#  Depois rode:  npm run teste-campo -- robo
# =====================================================================

# --- Login da cliente na Agência Virtual Neoenergia ---
# CPF ou CNPJ (com ou sem pontuação)
TESTE_LOGIN=
# Senha da Agência Virtual (se tiver # ou aspas, prefira o comando configurar)
TESTE_SENHA=
# cpf ou cnpj (se vazio, descobre pelo tamanho)
TESTE_TIPO_LOGIN=cpf
# Estado: SP (Elektro São Paulo) ou MS (Elektro Mato Grosso do Sul)
TESTE_UF=SP
# UC(s): o "NÚMERO DA UNIDADE CONSUMIDORA" do topo da fatura (ex.: 1.234.567.890-12).
# NÃO é o "Código débito em conta" (8 dígitos). Várias: separe por vírgula.
TESTE_UC=

# --- Navegador ---
# Janela visível para você acompanhar (recomendado no 1º teste)
ROBO_HEADLESS=false
# Se aparecer captcha ou tela desconhecida, o robô pausa e espera você clicar
ROBO_ASSISTIDO=true
# Quanto tempo (s) ele espera você agir no modo assistido
ROBO_ESPERA_ASSISTIDO_S=180
# Usa o Google Chrome já instalado no seu computador (recomendado).
# Deixe vazio para usar o Chromium do Playwright (exige: npx playwright install chromium)
ROBO_CANAL=chrome
# Prazo (s) para cada tela aparecer
ROBO_TIMEOUT_S=25

# --- Opcional: comparar com a Infosimples (1 consulta PAGA, ~R$ 0,30) ---
# npm run teste-campo -- infosimples
INFOSIMPLES_TOKEN=
