# ===== Banco de dados =====
DATABASE_URL=postgres://fatureiro:fatureiro@127.0.0.1:5432/fatureiro

# ===== Quem busca a fatura de cada distribuidora =====
# Neoenergia/Elektro: robo (robô próprio, padrão) | infosimples | nenhum
FATUREIRO_PROVEDOR_NEOENERGIA=robo
# CPFL: auto (Infosimples se houver token) | infosimples | nenhum
FATUREIRO_PROVEDOR_CPFL=auto

# ===== Robô próprio (Agência Virtual Neoenergia) =====
# Em servidor: true. No teste de campo / máquina com tela: false para acompanhar.
ROBO_HEADLESS=true
# chrome = usa o Google Chrome instalado (recomendado); vazio = Chromium do Playwright
ROBO_CANAL=chrome
# Modo assistido: pausa para uma pessoa resolver captcha/tela desconhecida (só com janela visível)
ROBO_ASSISTIDO=false
ROBO_ESPERA_ASSISTIDO_S=180
ROBO_TIMEOUT_S=20
# Pasta de rastreio (prints + mapa das telas). Vazio = desligado. CONTÉM DADOS DE CLIENTE.
ROBO_RASTREIO_DIR=
# Pausas de cortesia (s) entre clientes e entre UCs do mesmo cliente
ROBO_PAUSA_ENTRE_CLIENTES_S=5
ROBO_PAUSA_ENTRE_UCS_S=1.5

# ===== Infosimples (opcional; CPFL ou comparação) =====
# Token da conta da Invite (painel Infosimples > Administração > Tokens). NUNCA commitar.
INFOSIMPLES_TOKEN=
# Opcional: chave de criptografia da conta Infosimples (Administração > Conta).
# Quando informada, a senha do cliente é enviada como enc_login_senha (AES-256-GCM),
# e nunca trafega nem é persistida em claro do lado da Infosimples.
INFOSIMPLES_ENCRYPTION_KEY=
# timeout pedido à API (15..600) e timeout do nosso cliente HTTP (tem de ser MAIOR).
INFOSIMPLES_TIMEOUT_S=600
INFOSIMPLES_HTTP_TIMEOUT_S=620

# ===== Cofre de credenciais dos clientes =====
# 32 bytes: gere com `openssl rand -hex 32` (64 caracteres hex) ou base64 de 32 bytes.
# Perder esta chave = perder o acesso a todas as senhas cadastradas. Guarde em cofre (ex.: AWS Secrets Manager).
FATUREIRO_COFRE_CHAVE=

# ===== Regras do lote =====
# Teto de gasto mensal em R$ (pode ser sobrescrito pela tabela fatureiro.configuracoes, chave teto_mensal_brl).
FATUREIRO_TETO_MENSAL_BRL=300
# Chamadas simultâneas. Robô próprio: 1 (ele já faz um navegador por vez). Infosimples: 2 ou 3.
FATUREIRO_CONCORRENCIA=1
# Repetições com espera crescente para códigos transitórios, por unidade, por dia.
FATUREIRO_MAX_TENTATIVAS_DIA=3
# Máximo de consultas PAGAS por unidade dentro de um mesmo ciclo (mês de referência).
FATUREIRO_MAX_TENTATIVAS_CICLO=4
# Dias após a "próxima leitura" da fatura anterior para consultar de novo.
FATUREIRO_DIAS_APOS_LEITURA=3
# Quando a consulta devolve um mês já capturado, reagendar para N dias depois.
FATUREIRO_REAGENDAR_DUPLICADA_DIAS=3
# Taxa de sucesso mínima do serviço (último 60 min, endpoint api/admin/service) para rodar o lote. 0 desliga a checagem.
FATUREIRO_TAXA_SUCESSO_MINIMA=0.5

# ===== Armazenamento dos PDFs =====
# local | s3
ARMAZENAMENTO=local
ARMAZENAMENTO_LOCAL_DIR=./dados/pdfs
S3_BUCKET=
S3_REGION=sa-east-1
# Opcional (MinIO, Cloudflare R2, etc.)
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===== Alertas =====
# Opcional: URL que recebe um POST JSON quando o lote é interrompido ou o teto é atingido.
ALERTA_WEBHOOK_URL=

# debug | info | warn | error
LOG_NIVEL=info
